{;; jolt.ffi/write takes the value BEFORE the offset as of jolt 0.8.0; declare the
 ;; floor so an older runtime refuses instead of writing to the wrong place.
 :jolt/min-version "0.8.0"

 :paths ["src"]

 ;; glimmer = reactive core (no deps); glimmer-bui = BUI (Blender-look) backend,
 ;; GPL-2.0+; glimmer-gl/glimmer-gtk = image pane (textured quad + blit), same
 ;; pins splat-painter uses.
 :deps {jolt-lang/glimmer  {:git/url "https://github.com/jolt-lang/glimmer"
                            :git/tag "v0.1.4"
                            :git/sha "09b8ab08705fa1e6f20145c2e99eaaba9ea812cc"}
        ;; BUI (Blender-look) backend; GPL-2.0+
        jlt-commons/glimmer-bui {:git/url "https://github.com/jlt-commons/glimmer-bui"
                                 :git/tag "v0.1.2"
                                 :git/sha "aec93b499d01738a2ccab8785f0b92e944c18760"}
        ;; in-memory relational store: the document/layer data model
        yogthos/relatum {:git/url "https://github.com/yogthos/relatum"
                         :git/tag "v0.4.0"
                         :git/sha "6fefe4da6edc1a0ccf2783fe63c913fa810707fc"}}

 ;; the pixel engine (images, masks, compositing, tiles, PNG/JPEG/TIFF), the
 ;; ONNX Runtime C API (CPU + CoreML/CUDA execution providers), our CoreML
 ;; ObjC++ shim (macOS ANE, precompiled .mlmodelc), and LibRaw. Each entry is a
 ;; list of dlopen candidates tried in order. A packaged Almaz.app finds them in
 ;; its Frameworks folder instead (native/tools/package_macos.clj).
 :jolt/native [{:name "almazimg"
                :darwin ["native/img/lib/libalmazimg.dylib"]
                :linux  ["native/img/lib/libalmazimg.so" "libalmazimg.so"]}
               ;; :optional — load if present, don't error if absent. The app
               ;; falls back to CPU when these aren't installed (see almaz.infer.ep).
               ;; Each is our thin C shim (native/<backend>/lib/…) that links the
               ;; real engine (libonnxruntime / the CoreML framework) transitively.
               {:name "almazinfer-onnxruntime"
                :optional true
                :darwin ["native/onnxruntime/lib/libalmazinfer_onnxruntime.dylib"]
                :linux  ["native/onnxruntime/lib/libalmazinfer_onnxruntime.so" "libalmazinfer_onnxruntime.so"]}
               {:name "almazinfer-coreml"
                :optional true
                :darwin ["native/coreml/lib/libalmazinfer_coreml.dylib"]}
               ;; glimmer-bui declares the BUI kit by bare name plus paths on
               ;; its author's machine; this spec wins over its by :name, so
               ;; the copy `jolt native` builds into .deps/ is found first
               ;; without DYLD_LIBRARY_PATH. :optional so the headless tests
               ;; still run without it.
               {:name "bui"
                :optional true
                :darwin [".deps/bui/lib/libbui.dylib" "libbui.dylib"]
                :linux  [".deps/bui/lib/libbui.so" "libbui.so"]}
               {:name "almazinfer-raw"
                :optional true
                :darwin ["native/raw/lib/libalmazinfer_raw.dylib"]
                :linux  ["native/raw/lib/libalmazinfer_raw.so" "libalmazinfer_raw.so"]}]

 ;; dev/debug entry points under test/ — only the app itself ships from src/.
 :aliases {:run   {:main-opts ["-m" "almaz.core"]}
           :check {:extra-paths ["test"] :main-opts ["-m" "almaz.check"]}
           :test  {:extra-paths ["test"] :main-opts ["-m" "almaz.test-runner"]}}

 :tasks {release {:doc "package the app for this platform (macOS .app, Linux tarball)"
                  :task (shell "jolt" "native/tools/package.clj")}
         dist  {:doc "alias for release" :task (shell "jolt" "native/tools/package.clj")}
         ;; `run` is also a jolt built-in; this one is the app
         run   {:doc "the app (files to open may follow)" :task (apply jolt "-M:run" *command-line-args*) :override-builtin true}
         native {:doc "fetch LibRaw + BUI into .deps/ and build every native library"
                 ;; in-process: a fresh `jolt script` would refuse to start while
                 ;; the libraries it's about to build are missing
                 :task (load-file "native/tools/build_native.clj")}
         samples {:doc "fetch the RAW test files" :task (shell "native/tools/fetch_samples.sh")}
         check "jolt -M:check"
         test  "jolt -M:test"}}
