+/* File URLs on a pasteboard (a drag), as paths for bk_open_files. */
+static NSArray *file_urls(NSPasteboard *pb)
+{
+  NSDictionary *opts = @{NSPasteboardURLReadingFileURLsOnlyKey : @YES};
+  return [pb readObjectsForClasses:@[ [NSURL class] ] options:opts];
+}
+
+static void open_urls(BKWindow *win, NSArray *urls, int x, int y)
+{
+  const char **paths = (const char **)malloc(sizeof(char *) * ([urls count] + 1));
+  int n = 0;
+  for (NSURL *url in urls) {
+    if ([url isFileURL] && [url fileSystemRepresentation]) {
+      paths[n++] = [url fileSystemRepresentation]; /* autoreleased: valid for the call */
+    }
+  }
+  bk_open_files(win, paths, n, x, y);
+  free(paths);
+}
+
 @implementation BUIKitView
 
+/* Files dragged in from Finder (NSDraggingDestination). */
+- (NSDragOperation)draggingEntered:(id<NSDraggingInfo>)sender
+{
+  return [file_urls([sender draggingPasteboard]) count] ? NSDragOperationCopy : NSDragOperationNone;
+}
+
+- (NSDragOperation)draggingUpdated:(id<NSDraggingInfo>)sender
+{
+  return [self draggingEntered:sender];
+}
+
+- (BOOL)performDragOperation:(id<NSDraggingInfo>)sender
+{
+  NSArray *urls = file_urls([sender draggingPasteboard]);
+  if (![urls count] || !bk) {
+    return NO;
+  }
+  const NSPoint p = [self convertPoint:[sender draggingLocation] fromView:nil];
+  open_urls(bk, urls, (int)floor(p.x * bk->px), (int)floor(p.y * bk->px));
+  return YES;
+}
