+/* -- files handed to the app (BK_window_set_open_files) ------------------------ */
+typedef struct BKFileBatch {
+  char **paths;
+  int n, x, y;
+  struct BKFileBatch *next;
+} BKFileBatch;
+
+static BKOpenFilesFn g_open_files = NULL;
+static void *g_open_files_data = NULL;
+static BKFileBatch *g_file_queue = NULL; /* waiting for a handler, oldest first */
+
+void bk_free_paths(char **paths, int n)
+{
+  for (int i = 0; i < n; i++) {
+    free(paths[i]);
+  }
+  free(paths);
+}
+
+void bk_open_files(BKWindow *win, const char *const *paths, int n, int x, int y)
+{
+  if (n <= 0) {
+    return;
+  }
+  if (g_open_files) {
+    g_open_files(g_open_files_data, win, paths, n, x, y);
+    return;
+  }
+  /* no handler yet (an app opened with files): keep them, without the window */
+  BKFileBatch *b = (BKFileBatch *)calloc(1, sizeof(BKFileBatch));
+  b->paths = (char **)malloc(sizeof(char *) * (size_t)n);
+  for (int i = 0; i < n; i++) {
+    b->paths[i] = strdup(paths[i]);
+  }
+  b->n = n;
+  b->x = b->y = -1;
+  BKFileBatch **tail = &g_file_queue;
+  while (*tail) {
+    tail = &(*tail)->next;
+  }
+  *tail = b;
+}
+
+void BK_window_set_open_files(BKOpenFilesFn fn, void *data)
+{
+  g_open_files = fn;
+  g_open_files_data = data;
+  while (fn && g_file_queue) {
+    BKFileBatch *b = g_file_queue;
+    g_file_queue = b->next;
+    fn(data, NULL, (const char *const *)b->paths, b->n, b->x, b->y);
+    bk_free_paths(b->paths, b->n);
+    free(b);
+  }
+}
+
+static int hex_digit(int c)
+{
+  if (c >= '0' && c <= '9') {
+    return c - '0';
+  }
+  c = tolower(c);
+  return c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1;
+}
+
+int bk_uri_list_paths(const char *text, size_t len, char ***r_paths)
+{
+  int n = 0, cap = 4;
+  char **out = (char **)malloc(sizeof(char *) * (size_t)cap);
+  size_t i = 0;
+  while (i < len) {
+    size_t e = i;
+    while (e < len && text[e] != '\n' && text[e] != '\r' && text[e] != '\0') {
+      e++;
+    }
+    const char *line = text + i;
+    const size_t ll = e - i;
+    /* RFC 2483: "#" lines are comments; only file: URIs name local files */
+    if (ll > 5 && line[0] != '#' && strncmp(line, "file:", 5) == 0) {
+      const char *p = line + 5, *end = line + ll;
+      if (end - p >= 2 && p[0] == '/' && p[1] == '/') { /* file://host/path */
+        p += 2;
+        while (p < end && *p != '/') {
+          p++;
+        }
+      }
+      if (p < end && *p == '/') {
+        char *path = (char *)malloc((size_t)(end - p) + 1);
+        size_t k = 0;
+        for (; p < end; p++) {
+          int hi, lo;
+          if (*p == '%' && end - p >= 3 && (hi = hex_digit(p[1])) >= 0 && (lo = hex_digit(p[2])) >= 0) {
+            path[k++] = (char)(hi * 16 + lo);
+            p += 2;
+          }
+          else {
+            path[k++] = *p;
+          }
+        }
+        path[k] = 0;
+        if (n == cap) {
+          cap *= 2;
+          out = (char **)realloc(out, sizeof(char *) * (size_t)cap);
+        }
+        out[n++] = path;
+      }
+    }
+    i = e + 1;
+  }
+  *r_paths = out;
+  return n;
+}
