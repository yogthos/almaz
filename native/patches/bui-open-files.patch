+/* -- XDND: files dragged in from a file manager ---------------------------------- */
+static void xdnd_send(BKWindow *win, Atom type, long l1, long l2, long l3, long l4)
+{
+  XEvent m;
+  memset(&m, 0, sizeof(m));
+  m.xclient.type = ClientMessage;
+  m.xclient.display = g_dpy;
+  m.xclient.window = win->dnd_source;
+  m.xclient.message_type = type;
+  m.xclient.format = 32;
+  m.xclient.data.l[0] = (long)win->xid;
+  m.xclient.data.l[1] = l1;
+  m.xclient.data.l[2] = l2;
+  m.xclient.data.l[3] = l3;
+  m.xclient.data.l[4] = l4;
+  XSendEvent(g_dpy, win->dnd_source, False, NoEventMask, &m);
+  XFlush(g_dpy);
+}
+
+/* Does the drag offer text/uri-list? (In the message, or, with more than
+ * three types, in the source's XdndTypeList.) */
+static int xdnd_offers_files(const XClientMessageEvent *e)
+{
+  if (e->data.l[1] & 1) {
+    Atom type;
+    int format;
+    unsigned long n = 0, after;
+    unsigned char *prop = NULL;
+    int found = 0;
+    if (XGetWindowProperty(g_dpy, (Window)e->data.l[0], a_xdnd_type_list, 0, 1024, False, XA_ATOM,
+                           &type, &format, &n, &after, &prop) == Success && prop)
+    {
+      for (unsigned long i = 0; i < n; i++) {
+        found |= ((Atom *)prop)[i] == a_uri_list;
+      }
+      XFree(prop);
+    }
+    return found;
+  }
+  return (Atom)e->data.l[2] == a_uri_list || (Atom)e->data.l[3] == a_uri_list ||
+         (Atom)e->data.l[4] == a_uri_list;
+}
+
+static void xdnd_message(BKWindow *win, const XClientMessageEvent *e)
+{
+  const Atom t = e->message_type;
+  if (t == a_xdnd_enter) {
+    win->dnd_source = (Window)e->data.l[0];
+    win->dnd_version = (int)((unsigned long)e->data.l[1] >> 24);
+    win->dnd_files = win->dnd_version <= XDND_VERSION && xdnd_offers_files(e);
+  }
+  else if (t == a_xdnd_position) {
+    if ((Window)e->data.l[0] != win->dnd_source) {
+      return;
+    }
+    const int rx = (int)((unsigned long)e->data.l[2] >> 16), ry = (int)(e->data.l[2] & 0xffff);
+    Window child;
+    XTranslateCoordinates(g_dpy, RootWindow(g_dpy, DefaultScreen(g_dpy)), win->xid, rx, ry,
+                          &win->dnd_x, &win->dnd_y, &child);
+    /* accept (bit 0) and keep sending positions (empty rectangle) */
+    xdnd_send(win, a_xdnd_status, win->dnd_files ? 1 : 0, 0, 0, win->dnd_files ? (long)a_xdnd_copy : None);
+  }
+  else if (t == a_xdnd_leave) {
+    win->dnd_source = None;
+    win->dnd_files = 0;
+  }
+  else if (t == a_xdnd_drop) {
+    if ((Window)e->data.l[0] != win->dnd_source) {
+      return;
+    }
+    if (win->dnd_files) { /* the paths arrive as XdndSelection's SelectionNotify */
+      const Time when = win->dnd_version >= 1 ? (Time)e->data.l[2] : CurrentTime;
+      XConvertSelection(g_dpy, a_xdnd_selection, a_uri_list, a_xdnd_selection, win->xid, when);
+      XFlush(g_dpy);
+    }
+    else {
+      xdnd_send(win, a_xdnd_finished, 0, None, 0, 0);
+      win->dnd_source = None;
+    }
+  }
+}
+
+static void xdnd_selection(BKWindow *win, const XSelectionEvent *e)
+{
+  int ok = 0;
+  if (e->property != None) {
+    Atom type;
+    int format;
+    unsigned long n = 0, after;
+    unsigned char *prop = NULL;
+    if (XGetWindowProperty(g_dpy, win->xid, e->property, 0, 1 << 24, True, AnyPropertyType, &type,
+                           &format, &n, &after, &prop) == Success && prop)
+    {
+      char **paths = NULL;
+      const int count = bk_uri_list_paths((const char *)prop, n, &paths);
+      bk_open_files(win, (const char *const *)paths, count, win->dnd_x, win->dnd_y);
+      bk_free_paths(paths, count);
+      ok = count > 0;
+      XFree(prop);
+    }
+  }
+  if (win->dnd_source != None) {
+    xdnd_send(win, a_xdnd_finished, ok, ok ? (long)a_xdnd_copy : None, 0, 0);
+  }
+  win->dnd_source = None;
+  win->dnd_files = 0;
+}
