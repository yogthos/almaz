+static int in_BK_scroll_pixels(BKContext *ctx, int x, int y, int dy, int mods)
+{
+  if ((mods & BK_CTRL) || ctx->modal || ctx->npopups) {
+    return 0;
+  }
+  BKNode *target = hit_all(ctx, x, y);
+  if (!target && ctx->root && y >= ctx->header_h) {
+    target = deepest(ctx->root, x, y);
+  }
+  for (BKNode *n = target; n; n = n->parent) {
+    if (BK_IS_CUSTOM(n)) {
+      return 0; /* custom nodes take the wheel themselves */
+    }
+    if (n->cls == &bk_cls_scroll && NODE_ENABLED(n)) {
+      hide_tooltip(ctx);
+      if (dy) {
+        bk_scroll_view_by(n, dy);
+      }
+      return 1;
+    }
+  }
+  return 0;
+}
